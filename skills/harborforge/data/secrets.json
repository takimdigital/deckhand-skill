{
  "_about": "One secret policy for every scanner: dh verify (secrets row), dh harvest --push (secret scan), dh pool vet (committed secrets), the run-log and autopsy redaction, tryon save. Regexes are valid in Python and JavaScript. `values` = credentials that must never be in a repo; `strict_extra` = also refused in saved components and redacted from logs, but allowed in app code (Stripe test keys, public JWTs such as Supabase anon keys); `files` = files that are secrets by name (an .example/.sample/.template twin is fine).",
  "values": [
    {"id": "stripe-live", "rx": "\\b(sk|rk)_live_[0-9a-zA-Z]{10,}"},
    {"id": "stripe-webhook", "rx": "\\bwhsec_[A-Za-z0-9]{24,}"},
    {"id": "aws-access-key", "rx": "\\bAKIA[0-9A-Z]{16}\\b"},
    {"id": "github-token", "rx": "\\b(ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{30,}|\\bgithub_pat_[A-Za-z0-9_]{40,}"},
    {"id": "gitlab-token", "rx": "\\bglpat-[A-Za-z0-9_-]{20,}"},
    {"id": "slack-token", "rx": "\\bxox[baprs]-[A-Za-z0-9-]{10,}"},
    {"id": "slack-webhook", "rx": "hooks\\.slack\\.com/services/T[A-Za-z0-9]+/B[A-Za-z0-9]+/[A-Za-z0-9]{16,}"},
    {"id": "discord-webhook", "rx": "discord(app)?\\.com/api/webhooks/[0-9]{6,}/[A-Za-z0-9_-]{20,}"},
    {"id": "telegram-bot-token", "rx": "\\b[0-9]{8,10}:AA[A-Za-z0-9_-]{33}\\b"},
    {"id": "private-key", "rx": "-----BEGIN [A-Z ]*PRIVATE KEY-----"},
    {"id": "google-api-key", "rx": "\\bAIza[0-9A-Za-z_-]{35}"},
    {"id": "resend-key", "rx": "\\bre_[A-Za-z0-9]{8,}_[A-Za-z0-9]{10,}"},
    {"id": "sendgrid-key", "rx": "\\bSG\\.[A-Za-z0-9_-]{16,}\\.[A-Za-z0-9_-]{16,}"},
    {"id": "anthropic-key", "rx": "\\bsk-ant-[A-Za-z0-9_-]{32,}"},
    {"id": "openai-key", "rx": "\\bsk-(proj-|svcacct-)?[A-Za-z0-9_-]{32,}"},
    {"id": "npm-token", "rx": "\\bnpm_[A-Za-z0-9]{36}\\b"},
    {"id": "coolify-token", "rx": "\\b[0-9]{1,6}\\|[A-Za-z0-9]{40,}\\b"}
  ],
  "strict_extra": [
    {"id": "stripe-test", "rx": "\\b(sk|rk)_test_[0-9a-zA-Z]{10,}"},
    {"id": "jwt", "rx": "\\beyJ[A-Za-z0-9_-]{20,}\\.[A-Za-z0-9_-]{20,}\\.[A-Za-z0-9_-]*"}
  ],
  "files": "(^|/)(\\.env|\\.env\\.local|\\.env\\.production|\\.env\\.development|id_rsa|id_ed25519|credentials\\.json|service-account[\\w.-]*\\.json|[\\w.-]+\\.pem|[\\w.-]+\\.p12|[\\w.-]+\\.pfx)$"
}
