      "fix": "list what is on offer"
    },
    {
      "id": "future-is-here",
      "kind": "claim",
      "w": 3,
      "rx": "the future of [a-z ]{1,30} is (here|now)",
      "example": "The future of banking is here.",
      "fix": "say what is new"
    },
    {
      "id": "got-you-covered",
      "kind": "filler",
      "w": 2,
      "rx": "(we['’]?ve|we have) got you covered",
