  "phrases": [
    {
      "id": "in-todays-world",
      "kind": "opener",
      "w": 4,
      "rx": "in today['’]?s (fast-paced |digital |ever-changing |modern |busy )?(world|age|landscape|market|society)",
      "example": "In today's fast-paced world, time matters.",
      "fix": "start with the reader's problem or the fact"
    },
    {
      "id": "ever-changing-world",
      "kind": "opener",
      "w": 4,
      "rx": "(ever-evolving|ever-changing|rapidly evolving|constantly evolving) (world|landscape|market|industry|digital)",
      "example": "the ever-changing digital landscape",
      "fix": "cut it"
    },
    {
      "id": "in-a-world",
      "kind": "opener",
      "w": 3,
      "rx": "in a world (where|of|full of|that)",
      "example": "In a world where everyone is busy",
      "fix": "cut it and start with the point"
    },
    {
      "id": "digital-age",
      "kind": "opener",
      "w": 3,
      "rx": "in (the|this|an|today['’]?s) (digital|modern) (age|era)|in an (era|age) (of|where)",
      "example": "In the digital age, websites matter.",
      "fix": "cut it"
    },
    {
      "id": "realm-of",
      "kind": "filler",
      "w": 3,
      "rx": "in the (realm|world) of [a-z]+ (and|where)",
      "example": "in the realm of fitness and wellness",
      "fix": "in (the field)"
    },
    {
      "id": "worth-noting",
      "kind": "hedge",
      "w": 3,
      "rx": "it['’]?s (worth noting|important to note|worth mentioning|important to remember|important to consider|crucial to understand)( that)?|it is (worth noting|important to note|important to remember)( that)?",
      "example": "It's worth noting that we open on Sundays.",
      "fix": "say the fact"
    },
    {
      "id": "navigate-complexities",
      "kind": "filler",
      "w": 3,
      "rx": "navigat(e|ing) the (complexities|challenges|intricacies|world|landscape|maze)",
      "example": "we help you navigate the complexities of tax",
      "fix": "say what you do: file, check, answer"
    },
    {
      "id": "look-no-further",
      "kind": "cta",
      "w": 3,
      "rx": "look no further",
      "example": "Looking for a plumber? Look no further.",
      "fix": "give the reason to choose you"
    },
    {
      "id": "whether-youre",
      "kind": "structure",
      "w": 2,
      "rx": "whether you['’]?re (a|an|looking|new|just) [^,.;]{1,40},? or ",
      "example": "Whether you're a beginner or a pro, we have a class.",
      "fix": "name who it is for"
    },
    {
      "id": "not-just-x",
      "kind": "structure",
      "w": 3,
      "rx": "\\bnot (just|only|merely|simply) (a|an|about) [^.;!?]{1,60}[,;—–-]+ ?(it['’]?s|but|we['’]?re|this is)",
      "example": "Not just a gym, it's a community.",
      "fix": "say what it is"
    },
    {
      "id": "its-not-x-its-y",
      "kind": "structure",
      "w": 3,
      "rx": "\\b(it|this|that)['’]?s not (just |only |about )?[^.;!?]{1,50}[.,;—–-]+ ?(it|this|that)['’]?s\\b",
      "example": "It's not a haircut. It's a ritual.",
      "fix": "say what it is, once"
    },
    {
      "id": "more-than-just",
      "kind": "structure",
      "w": 2,
      "rx": "more than (just )?(a|an) (simple |mere |ordinary )?[a-z]+",
      "example": "more than just a bakery",
      "fix": "say what else it is"
    },
    {
      "id": "ready-to",
      "kind": "cta",
      "w": 2,
      "rx": "ready to (take|transform|elevate|start|begin|unlock|experience|discover|get started|join)[^?]{0,40}\\?",
      "example": "Ready to transform your garden?",
      "fix": "an action label: Book a visit"
    },
    {
      "id": "next-level",
      "kind": "cta",
      "w": 3,
      "rx": "(take|bring|elevate|push) (it|this|things|your [a-z]+( [a-z]+)?) to (the|a) (next|new|whole new) level",
      "example": "Take your business to the next level.",
      "fix": "say the result: 20 more bookings a week"
    },
    {
      "id": "unlock-potential",
      "kind": "filler",
      "w": 3,
      "rx": "(unlock|unleash|realise|realize|reach|maximi[sz]e) (your|the|their|its) (full |true |hidden )?potential",
      "example": "unlock your full potential",
      "fix": "say the result"
    },
    {
      "id": "testament-to",
      "kind": "filler",
      "w": 3,
      "rx": "(a|is a|stands as a|serves as a) (true |living )?testament to",
      "example": "our bakery is a testament to the timeless art of bread",
      "fix": "proof: say what shows it"
    },
    {
      "id": "foster-abstract",
      "kind": "filler",
      "w": 3,
      "rx": "foster(s|ing)? (a |an )?(sense of|culture of|community|collaboration|growth|innovation|connection|engagement|creativity)",
      "example": "we foster a culture of innovation",
      "fix": "say what you do: weekly meetups, shared tools"
    },
    {
      "id": "power-of",
      "kind": "filler",
      "w": 3,
      "rx": "(harness|unleash|discover|experience|unlock|leverage) the (full |true )?power of",
