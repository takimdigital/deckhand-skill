      "fix": "say what is included"
    },
    {
      "id": "join-thousands",
      "kind": "claim",
      "w": 2,
      "rx": "join (the )?(thousands|millions|hundreds) of",
      "example": "Join thousands of happy customers.",
      "fix": "the real number, or cut it"
    },
    {
      "id": "perhaps-perhaps",
      "kind": "structure",
      "w": 2,
      "rx": "perhaps [^,.]{1,40}, perhaps",
      "example": "Perhaps it's the bread, perhaps the people.",
      "fix": "choose one"
    },
    {
      "id": "imagine-a",
      "kind": "opener",
      "w": 2,
      "rx": "^imagine (a|an|if|your|waking|walking|having)",
      "example": "Imagine a place where you can relax.",
      "fix": "describe the place"
    },
    {
      "id": "from-x-to-y-we",
      "kind": "structure",
      "w": 2,
      "rx": "from [a-z-]+( [a-z-]+)? to [a-z-]+( [a-z-]+)?, (we|our)",
      "example": "From startups to enterprises, we build apps.",
      "fix": "name who you work for"
    },
    {
      "id": "chat-leak",
      "kind": "leak",
      "w": 5,
      "rx": "as an ai|as a language model|i hope this helps|great question|certainly! here|here['’]?s (a|an|the) (revised|updated|improved) version|feel free to (adjust|customi[sz]e)|\\[insert [a-z ]+\\]",
