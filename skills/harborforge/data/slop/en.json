      "fix": "say what you do and for whom"
    },
    {
      "id": "we-understand",
      "kind": "hedge",
      "w": 2,
      "rx": "we (understand|know) (that|how) (every|each|your|finding|choosing|it can)",
      "example": "We understand that every smile is unique.",
      "fix": "say what you do about it"
    },
    {
      "id": "commitment-excellence",
      "kind": "claim",
      "w": 2,
      "rx": "(commitment|committed|dedicated|dedication) to (excellence|quality|innovation|providing|delivering|your success)",
