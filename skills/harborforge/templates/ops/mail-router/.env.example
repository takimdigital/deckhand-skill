# --- chain ---------------------------------------------------------------
EMAIL_CHAIN=resend,mailgun,brevo        # order = priority; first 2xx wins
EMAIL_TIMEOUT_MS=8000                   # per-attempt abort
APP_URL=https://app.example.com         # link-integrity origin allowlist
OWNER_ALERT_EMAIL=owner@example.com     # gets "provider throttled" alerts
ALERT_WEBHOOK_URL=                      # optional: Slack/Discord/ntfy webhook

# --- Resend (mail1.example.com) ------------------------------------------
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM="App <no-reply@mail1.example.com>"
RESEND_DAILY_CAP=95                     # real free cap 100/day, 3000/mo (UTC day)

# --- Mailgun (mail3.example.com) -----------------------------------------
MAILGUN_API_KEY=xxxxxxxx
MAILGUN_DOMAIN=mail3.example.com        # verified sending subdomain
MAILGUN_FROM="App <no-reply@mail3.example.com>"
MAILGUN_DAILY_CAP=95                    # real free cap 100/day, 1 custom domain

# --- Brevo (mail2.example.com) -------------------------------------------
BREVO_API_KEY=xkeysib-xxxxxxxx
BREVO_FROM="App <no-reply@mail2.example.com>"
BREVO_DAILY_CAP=290                     # real free cap 300/day
